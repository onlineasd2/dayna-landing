# Telegram-бот, в который приходят заявки.
# Токен выдаёт @BotFather: /newbot → скопируйте токен вида 123456:ABC-DEF...
TELEGRAM_BOT_TOKEN=

# ID чата/группы, куда слать заявки.
# Напишите боту /start (или добавьте его в группу), затем откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates и возьмите chat.id (у групп он отрицательный).
TELEGRAM_CHAT_ID=

# Публичный адрес сайта — для canonical, sitemap, OG-картинки. Без слеша в конце.
# Если не задан, на Vercel используется адрес проекта (*.vercel.app).
NEXT_PUBLIC_SITE_URL=
